# Copy this file to .env in this same folder (vinzor-core/), then replace
# the placeholder values below with your own. .env is already in .gitignore
# -- it will never be committed.
#
# Nothing here is read automatically by anything except `python -m vinzor`.
# It is loaded once, at the start of the command, straight into the same
# place a real "set" or "export" would put it. A value already set in your
# actual terminal always wins over this file.

# ---------------------------------------------------------------------------
# The AI assistant (Azure OpenAI) -- powers `python -m vinzor assist`
# ---------------------------------------------------------------------------

# From your Azure OpenAI resource's "Keys and Endpoint" page.
# Looks like: https://your-resource-name.openai.azure.com/
AZURE_OPENAI_ENDPOINT=

# The deployment name YOU chose when you deployed a model in Azure AI Studio
# -- not the model's own name (e.g. not "gpt-4o-mini"). Find it under
# your resource -> Deployments.
AZURE_OPENAI_DEPLOYMENT=

# Must be an Azure region physically in India: centralindia, southindia,
# westindia, jioindiacentral or jioindiawest. This is enforced twice --
# once here, once against what Azure actually reports back on every
# response -- so a deployment outside India is refused, not just discouraged.
AZURE_OPENAI_REGION=centralindia

# From the same "Keys and Endpoint" page as the endpoint above. Either
# KEY 1 or KEY 2 works; keep the other as a spare you can rotate to.
AZURE_OPENAI_KEY=

# ---------------------------------------------------------------------------
# Optional -- sensible defaults exist for all four below. Only set these if
# you know you need to.
# ---------------------------------------------------------------------------

# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_COST_INPUT=0.00015
# AZURE_OPENAI_COST_OUTPUT=0.00060

# ---------------------------------------------------------------------------
# Live sanctions screening -- powers `python -m vinzor screen` / `rescreen`
# ---------------------------------------------------------------------------

# Leave these three unset to use the self-hosted stack in selfhost/ instead
# (no key needed at all -- see selfhost/yente.ps1). Set them only if you are
# paying for OpenSanctions' hosted API instead of running your own.

# VINZOR_SCREENING_URL=https://api.opensanctions.org
# VINZOR_SCREENING_KEY=
# VINZOR_SCREENING_SCOPE=default

# ---------------------------------------------------------------------------
# Company registries -- power the assistant's lookup_company_uk and
# lookup_company tools (vinzor/registries.py)
# ---------------------------------------------------------------------------

# UK Companies House needs no key for the company and PSC lookups this
# system makes. Set one only to raise the rate limit.
# VINZOR_COMPANIES_HOUSE_KEY=

# OpenCorporates does need a token -- its free tier is 50 requests/day.
# Without this, the lookup_company tool says so plainly rather than
# searching anyway or returning nothing.
# VINZOR_OPENCORPORATES_TOKEN=
