# How the workspace is launched on the server.
#
# In the repository rather than on the machine, so that "how does this run in
# production" is a question the source answers. Applied by deploy/apply.sh,
# which verifies it, reloads systemd and restarts -- and puts the previous
# unit back if the service does not come up under the new one.
#
# The counterpart of running it by hand:
#   python -m vinzor serve --workspace live.db --port 8000

[Unit]
Description=Vinzor Core - IFSCA compliance workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Not root, and not the owner of the code either. /opt/vinzor belongs to
# root and this user only reads it, so the process cannot rewrite its own
# source; everything it writes is under /var/lib/vinzor.
User=vinzor
Group=vinzor

# The working directory is the workspace, not the checkout, and that is
# load-bearing: __main__.py reads .env relative to the working directory.
# Sitting in /opt/vinzor would mean a .env that appeared in the checkout got
# loaded silently. Nothing is ever meant to appear there -- .env is
# gitignored -- but the directory the process sits in should not be the one
# secrets would arrive in.
WorkingDirectory=/var/lib/vinzor
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/vinzor

# The assistant, over Bedrock. There is deliberately no key here and none on
# the machine: the instance has a role, and bedrock.py mints a credential per
# request from the instance metadata service. A key in this file would be a
# secret in version control, which is the one thing AGENTS.md refuses outright.
#
# The region is stated rather than inherited so that it is reviewable here.
# It is also enforced three further times -- by bedrock.py's allowlist, by its
# refusal of cross-region inference profiles, and by the IAM policy on the
# role, which grants only `arn:aws:bedrock:ap-south-1::foundation-model/*`.
# That last one is the belt: a foundation-model ARN carries no account id and
# an inference-profile ARN does, so the grant cannot reach a profile that
# would route the data out of India even if the code were changed to ask.
Environment=VINZOR_BEDROCK=1
Environment=VINZOR_BEDROCK_REGION=ap-south-1

# An absolute path on purpose. Amazon Linux 2023 ships 3.9 as `python3` and
# installs the 3.11 the core requires here; naming it exactly means a
# machine missing that package fails at start-up with a clear error rather
# than running the product on an interpreter it does not support.
ExecStart=/usr/bin/python3.11 -m vinzor serve --workspace /var/lib/vinzor/live.db --port 8000

# The log is a single-writer SQLite file with WAL sidecars beside it. A
# crash mid-append leaves a recoverable file, so coming straight back up is
# right; three seconds is enough to avoid a tight restart loop hammering it.
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vinzor

[Install]
WantedBy=multi-user.target
